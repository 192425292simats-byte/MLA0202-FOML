import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
ram = np.array([2, 3, 4, 6, 8, 12]).reshape(-1, 1)
price = np.array([5000, 8000, 10000, 15000, 20000, 30000])
model = LinearRegression()
model.fit(ram, price)
pred = model.predict(ram)
plt.scatter(ram, price)
plt.plot(ram, pred, color='red')
plt.xlabel("RAM (GB)")
plt.ylabel("Price (Rs)")
plt.title("Mobile Price Prediction")
plt.show()
print("Predicted Price:", model.predict([[6]])[0])
