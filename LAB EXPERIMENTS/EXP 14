import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
area = np.array([500, 700, 900, 1100, 1300, 1500]).reshape(-1, 1)
price = np.array([15, 20, 25, 30, 35, 40])
model = LinearRegression()
model.fit(area, price)
predicted = model.predict(area)
plt.scatter(area, price, color='blue', label='Actual Price')
plt.plot(area, predicted, color='red', label='Predicted Price')
plt.xlabel('House Area (sq.ft)')
plt.ylabel('Price (Lakhs)')
plt.title('House Price Prediction')
plt.legend()
plt.show()
new_area = np.array([[1200]])
print("Predicted House Price:", model.predict(new_area)[0], "Lakhs")
