import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
month = np.array([1,2,3,4,5,6]).reshape(-1,1)
sales = [100,120,140,160,180,200]
model = LinearRegression()
model.fit(month,sales)
pred = model.predict(month)
print("Future Sales:", model.predict([[7]])[0])
plt.scatter(month,sales)
plt.plot(month,pred,color='red')
plt.xlabel("Month")
plt.ylabel("Sales")
plt.title("Future Sales Prediction")
plt.show()
